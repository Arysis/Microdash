# Copier en .env et adapter.
POSTGRES_PASSWORD=change-moi

# Version des images à lancer : "dev" pour les images construites en local. En prod, chaque
# déploiement l'écrit lui-même (ex. sha-1a2b3c4).
MICRODASH_VERSION=dev

# Adresse publique du site, sans / final (image de partage, adresse canonique).
# Lue au moment de construire l'image web.
# Exemple : SITE_URL=https://www.mondomaine.fr
SITE_URL=

# Port exposé par le conteneur web. Derrière un proxy HTTPS (Caddy) sur le même serveur,
# 127.0.0.1:8080 le cache d'Internet : seul le proxy le joint.
WEB_PORT=8080

# false en local (http://localhost), true en prod derrière HTTPS.
COOKIE_SECURE=false

# Rappels par e-mail via Resend. Vide : aucun e-mail ne part.
# Avec une clé, il faut aussi ALERTES_SECRET, ALERTES_EXPEDITEUR et SITE_URL.
RESEND_API_KEY=
# Secret des liens de désinscription, au moins 32 caractères (ex. : openssl rand -hex 32).
# Le changer rend caducs les liens des e-mails déjà envoyés.
ALERTES_SECRET=
# Expéditeur sur un domaine vérifié dans Resend, ex. : Microdash <rappels@mondomaine.fr>
ALERTES_EXPEDITEUR=
# Tant que le domaine n'est pas vérifié, Resend n'envoie qu'à ta propre adresse :
# mets-la ici pour n'écrire qu'à elle (plusieurs adresses séparées par des virgules).
# Vide : tous les comptes reçoivent leurs rappels.
ALERTES_LIMITER_A=

# Chiffre les clés Stripe que chaque compte colle dans l'app (64 caractères hexadécimaux,
# ex. : openssl rand -hex 32). Vide : la connexion Stripe est désactivée.
# La changer rend illisibles les clés déjà enregistrées : il faudra les recoller.
CLE_CHIFFREMENT=

# Mot de passe oublié sans e-mail (temporaire) : adresses autorisées à changer leur mot de passe
# avec l'e-mail seul, séparées par des virgules, ou * pour tous. Vide : page désactivée.
# N'importe qui connaissant une adresse listée peut prendre le compte : vide-la après usage.
MDP_OUBLIE_EMAILS=
