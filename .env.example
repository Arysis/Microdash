# Copier en .env et adapter.
POSTGRES_PASSWORD=change-moi

# Version des images à lancer (prod) ; "dev" pour les images construites en local.
MICRODASH_VERSION=dev

# Port exposé par le conteneur web.
WEB_PORT=8080

# false en local (http://localhost), true en prod derrière HTTPS.
COOKIE_SECURE=false

# Clé Resend pour les e-mails de rappel (étape 3).
RESEND_API_KEY=
